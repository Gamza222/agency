{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path Aliases for FSD (Feature-Sliced Design) */
    "baseUrl": ".", // Base directory for path resolution
    "paths": {
      "@/*": ["./src/*"], // Root source directory
      "@app/*": ["./src/app/*"], // Application layer (Next.js App Router)
      "@pages/*": ["./src/compositions/*"], // Pages layer (FSD page compositions - renamed to avoid Next.js Pages Router conflict)
      "@widgets/*": ["./src/widgets/*"], // Widget layer
      "@features/*": ["./src/features/*"], // Features layer
      "@entities/*": ["./src/entities/*"], // Entities layer
      "@shared/*": ["./src/shared/*"], // Shared layer
      "@infrastructure/*": ["./src/infrastructure/*"], // Infrastructure layer
      "@config/*": ["./config/*"], // Config directory
      "@jestmocks/*": ["./config/jest/mocks/*"], // Jest mocks
      "@jestproviders/*": ["./config/jest/providers/*"] // Jest providers
    },
    "forceConsistentCasingInFileNames": true, // Ensure consistent casing in imports
    "sourceMap": true // Generate source maps for debugging
  },
  "include": [
    "src",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules", // Exclude node_modules from compilation
    "**/*.js", // Exclude JavaScript files from TypeScript compilation
    "structure/**/*" // Exclude structure directory (Cypress tests, etc.)
  ]
}
